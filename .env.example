# Configuration du serveur
PORT=3000
NODE_ENV=development

# Connexion Base de Données MySQL (Web Hosting Canada / WHC.ca ou local)
# Sur WHC cPanel : l'hôte est habituellement 'localhost' ou '127.0.0.1'
DB_HOST=localhost
DB_PORT=3306
DB_USER=votre_utilisateur_mysql
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=votre_base_pactenumerique

# Clé secrète pour le hachage salé des courriels (empêche les attaques par dictionnaire)
# Générez une chaîne aléatoire d'au moins 32 caractères
SERVER_SALT=changez_ce_sel_secret_tres_long_et_securitaire_12345

# Clés VAPID pour les notifications fureteur (Web Push)
# Vous pouvez en générer de nouvelles avec la commande: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@pactenumerique.ca
